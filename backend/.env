# ─── Database ─────────────────────────────────────────────
# Local SQLite:
DATABASE_URL=sqlite:///./phindu.db
# For Render/Postgres, uncomment and use:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/phindu

# ─── Auth ─────────────────────────────────────────────────
# Change this to a random 64-character string in production.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=bc1e9da4243fdb76486d0663949ff7be3e3a423940468f417b9147f705da47b6

# ─── Token lifetime ───────────────────────────────────────
# Access token validity in minutes. 60*24*7 = 7 days.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
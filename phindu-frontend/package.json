    "@testing-library/svelte": "^5.4.2",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.15.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.9",
    "postcss-nesting": "^14.0.0",
    "prettier": "^3.4.1",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte": "^5.55.1",
